# ============================================
# Keson Spectral Improver Core - Environment Config
# ============================================
# Copy this file to .env and fill in your values

# ---- Server Configuration ----
PORT=3001

# ---- IDHS (idonthavespotify) Connection ----
# URL of your IDHS instance (for link conversion)
IDHS_API_BASE_URL=http://localhost:3000
IDHS_REQUEST_TIMEOUT_MS=15000

# ---- Download Tools ----

# SoundCloud OAuth Token (for higher quality downloads)
# Get this by inspecting network requests in browser when logged into SoundCloud
# SOUNDCLOUD_OAUTH_TOKEN=1-123456-1234567890-abcdefghij

# Optional: Custom paths for download tools (default: use from PATH)
# YT_DLP_BINARY_PATH=yt-dlp
# TIDAL_DL_NG_PATH=tidal-dl-ng

# Optional: yt-dlp cookies file for premium access
# YT_DLP_COOKIES_PATH=/path/to/cookies.txt

# Optional: Skip SSL certificate verification (not recommended)
# YT_DLP_SKIP_CERT_CHECK=false

# ---- Tidal Configuration ----
# Option 1: Local login (run `tidal-dl-ng login` once)
#           Credentials are stored in ~/.config/tidal_dl_ng/

# Option 2: Docker/Portainer - Paste JSON content as env vars
# Get these from your local ~/.config/tidal_dl_ng/ after running `tidal-dl-ng login`
# TIDAL_TOKEN_JSON={"access_token":"...","refresh_token":"...","token_type":"Bearer","expires_at":...}
# TIDAL_SETTINGS_JSON={"quality_audio":"LOSSLESS","download_path":"./downloads"}

# ---- Quality Analysis ----
ENABLE_QUALITY_ANALYSIS=true
QUALITY_ANALYSIS_DEBUG=false

# ---- FFmpeg/FFprobe (usually auto-detected) ----
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# ---- Downloads Directory ----
# Where downloaded files are stored and served from
DOWNLOADS_DIR=./downloads

# ---- Rate Limiting ----
# Maximum concurrent download processes (yt-dlp / tidal-dl-ng)
MAX_CONCURRENT_DOWNLOADS=3
# Maximum pending requests in queue before returning 503
MAX_QUEUE_SIZE=20
