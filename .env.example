# ============================================
# Keson Spectral Improver - Environment Config
# ============================================
# Copy this file to .env and fill in your values

# ---- IDHS (idonthavespotify) Configuration ----
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Get these from https://developer.tidal.com/
TIDAL_CLIENT_ID=your_tidal_client_id
TIDAL_CLIENT_SECRET=your_tidal_client_secret

# Get this from https://console.developers.google.com/
YOUTUBE_API_KEY=your_youtube_api_key

# Optional: IDHS settings
IDHS_PORT=3000
LOG_LEVEL=info

# ---- Keson Core Configuration ----
# Required: Get from SoundCloud (auth token from browser dev tools)
SOUNDCLOUD_OAUTH_TOKEN=your_soundcloud_oauth_token

# Optional: Keson settings
KESON_PORT=3001
ENABLE_QUALITY_ANALYSIS=true
QUALITY_ANALYSIS_DEBUG=false
IDHS_REQUEST_TIMEOUT_MS=15000
