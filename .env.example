# ============================================
# Keson Spectral Improver Core - Environment Config
# ============================================
# Copy this file to .env and fill in your values
# For Docker/Portainer, add these as environment variables in your stack

# ---- Docker Compose Ports ----
KESON_PORT=42069
IDHS_PORT=3000

# ---- IDHS (idonthavespotify) API Credentials ----
# Required for link conversion (Spotify/Apple Music → SoundCloud)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
TIDAL_CLIENT_ID=your_tidal_client_id
TIDAL_CLIENT_SECRET=your_tidal_client_secret
YOUTUBE_API_KEY=your_youtube_api_key

# ---- IDHS Connection ----
# In docker-compose, this is set to http://idhs:3000 automatically
# IDHS_API_BASE_URL=http://localhost:3000
IDHS_REQUEST_TIMEOUT_MS=15000

# ---- SoundCloud ----
# OAuth Token for higher quality downloads
# Get this by inspecting network requests when logged into SoundCloud
SOUNDCLOUD_OAUTH_TOKEN=1-123456-1234567890-abcdefghij

# ---- Tidal Configuration ----
# For Docker: Paste JSON content from your local ~/.config/tidal_dl_ng/
# Run `tidal-dl-ng login` locally first to get these values
TIDAL_TOKEN_JSON={"access_token":"...","refresh_token":"...","token_type":"Bearer","expires_at":...}
TIDAL_SETTINGS_JSON={"quality_audio":"LOSSLESS","download_path":"./downloads"}

# ---- Auth System ----
# Number of registrations before invite code rotates (default: 25)
INVITE_BATCH_SIZE=25

# ---- Quality Analysis ----
ENABLE_QUALITY_ANALYSIS=true
QUALITY_ANALYSIS_DEBUG=false

# ---- Rate Limiting ----
MAX_CONCURRENT_DOWNLOADS=3
MAX_QUEUE_SIZE=20
